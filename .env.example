# Local development (PGlite — no Postgres required)
# NUXT_DATABASE_URL=

# Production / Docker Compose (Postgres)
# DATABASE_URL=postgres://arus:arus@postgres:5432/arus
# NUXT_DATABASE_URL=postgres://arus:arus@postgres:5432/arus

# Session cookie signing (required, min 32 chars)
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-string-at-least-32

# AES-256-GCM key used to encrypt user AI API keys at rest
NUXT_AI_ENCRYPTION_KEY=change-me-to-another-long-random-string

# Docker Compose publishes the app on host port 3100 by default
# (the container still listens on 3000). Override if that port is taken:
# APP_PORT=8088

# Public URL of this app (password-reset links, OAuth callback).
# Local `npm run dev`: http://localhost:3000
# Docker Compose:     http://localhost:<APP_PORT>  (default 3100)
NUXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Google OAuth (optional — leave blank to hide "Continue with Google")
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Provider-level keys are NOT used. Each user stores their own encrypted key.
